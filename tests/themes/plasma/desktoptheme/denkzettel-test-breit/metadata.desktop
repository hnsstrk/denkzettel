# Fixture of the test suite. Not a design proposal.
#
# The KPlugin data of this theme stays in metadata.json beside this file, where
# KSvg reads it. What lives here is the one group KSvg does not read and Plasma
# does: the four numbers a theme asks the compositor's contrast effect for
# (issue #83, AK 6). Two of the desktop themes installed on the customer's
# machine carry exactly this group; the tests must not depend on those, or a
# machine without them would run the assertion against nothing.
#
# The narrow bundled theme deliberately has no such file — it is the other half
# of the assertion: no group, no contrast effect.

[ContrastEffect]
enabled=true
contrast=1.0
intensity=0.40
saturation=1.4
