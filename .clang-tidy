# clang-tidy for Denkzettel. Run through the CMake target `lint-tidy` and never
# as CMAKE_CXX_CLANG_TIDY, so an ordinary build does not pay for the analysis.
#
# cppcoreguidelines-* is left out on purpose: it contradicts the Qt parent/child
# model systematically, where every `new QWidget(this)` is an owning raw pointer
# by design.
#
# Two standing rules for misc-const-correctness, each named by a NOLINT in the
# code:
# 1) On a local that is returned, performance-no-automatic-move wins — the
# variable stays non-const, because the `const` would stop the move and cost a
# copy on every call.
# 2) On an object changed through a Qt connection, `const` is not set: `connect`,
# `QSignalSpy` and `QTest::qExec` take their target as `const QObject *` and
# const_cast internally, and modifying an object defined const is undefined
# behaviour ([dcl.type.cv]/4). Pointers are not affected — `const QPushButton
# *edit` qualifies the pointer, not the object.
Checks: '-*,bugprone-*,performance-*,misc-const-correctness'

# Project headers are analysed, the AUTOMOC output is not - it sits in
# <build>/src/*_autogen/, a path that matches the src/ pattern as well.
HeaderFilterRegex: '.*/(src|tests)/.*\.h$'
ExcludeHeaderFilterRegex: '.*_autogen.*'

CheckOptions:
  # Setting any of these three options REPLACES the upstream default list
  # instead of extending it — that is why the upstream defaults are repeated in
  # front of our own entries.
  #
  # The two assert-side-effect options are what would have caught issue #99, and
  # neither works without the other: `AssertMacros` does not know Q_ASSERT by
  # default, and `CheckFunctionCalls` defaults to false, which leaves out
  # exactly the case there — a call inside an assertion, silently not executed
  # because QT_NO_DEBUG (set for every build type but Debug) makes Q_ASSERT drop
  # its condition. Upstream turns CheckFunctionCalls off for false positives;
  # measured over src/ and tests/ it raises none.
  - key: bugprone-assert-side-effect.AssertMacros
    value: 'assert,NSAssert,NSCAssert,Q_ASSERT,Q_ASSERT_X'
  - key: bugprone-assert-side-effect.CheckFunctionCalls
    value: 'true'
  # Our three entries sit at the end of the upstream list: a registration at a
  # foreign service must not lose its return value, because an ignored false
  # means the registration never arrived and nobody notices (SPEC 2.3, 2.4).
  - key: bugprone-unused-return-value.CheckedFunctions
    value: '^::std::async$;^::std::launder$;^::std::remove$;^::std::remove_if$;^::std::unique$;^::std::unique_ptr::release$;^::std::basic_string::empty$;^::std::vector::empty$;^::std::back_inserter$;^::std::distance$;^::std::find$;^::std::find_if$;^::std::inserter$;^::std::lower_bound$;^::std::make_pair$;^::std::map::count$;^::std::map::find$;^::std::map::lower_bound$;^::std::multimap::equal_range$;^::std::multimap::upper_bound$;^::std::set::count$;^::std::set::find$;^::std::setfill$;^::std::setprecision$;^::std::setw$;^::std::upper_bound$;^::std::vector::at$;^::bsearch$;^::ferror$;^::feof$;^::isalnum$;^::isalpha$;^::isblank$;^::iscntrl$;^::isdigit$;^::isgraph$;^::islower$;^::isprint$;^::ispunct$;^::isspace$;^::isupper$;^::iswalnum$;^::iswprint$;^::iswspace$;^::isxdigit$;^::memchr$;^::memcmp$;^::strcmp$;^::strcoll$;^::strncmp$;^::strpbrk$;^::strrchr$;^::strspn$;^::strstr$;^::wcscmp$;^::access$;^::bind$;^::connect$;^::difftime$;^::dlsym$;^::fnmatch$;^::getaddrinfo$;^::getopt$;^::htonl$;^::htons$;^::iconv_open$;^::inet_addr$;^::isascii$;^::isatty$;^::mmap$;^::newlocale$;^::openat$;^::pathconf$;^::pthread_equal$;^::pthread_getspecific$;^::pthread_mutex_trylock$;^::readdir$;^::readlink$;^::recvmsg$;^::regexec$;^::scandir$;^::semget$;^::setjmp$;^::shm_open$;^::shmget$;^::sigismember$;^::strcasecmp$;^::strsignal$;^::ttyname$;^::QDBusConnection::registerObject$;^::QDBusConnection::registerService$;^::DaemonService::registerOnSessionBus$'
